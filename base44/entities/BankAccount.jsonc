{
  "name": "BankAccount",
  "type": "object",
  "properties": {
    "bank_name": {
      "type": "string",
      "title": "Bank name"
    },
    "account_title": {
      "type": "string",
      "title": "Account title"
    },
    "account_number": {
      "type": "string",
      "title": "Account number"
    },
    "iban": {
      "type": "string",
      "title": "IBAN"
    },
    "swift_code": {
      "type": "string",
      "title": "SWIFT / BIC code"
    },
    "branch_name": {
      "type": "string",
      "title": "Branch name"
    },
    "branch_code": {
      "type": "string",
      "title": "Branch code"
    },
    "bank_address": {
      "type": "string",
      "title": "Bank address"
    },
    "currency": {
      "type": "string",
      "title": "Account currency"
    },
    "instructions": {
      "type": "string",
      "title": "Payment instructions"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active on checkout"
    },
    "display_order": {
      "type": "number",
      "title": "Display order"
    }
  },
  "required": [
    "bank_name",
    "account_title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}