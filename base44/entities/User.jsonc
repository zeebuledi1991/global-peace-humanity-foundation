{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "country": {
      "type": "string",
      "title": "Country"
    },
    "phone": {
      "type": "string",
      "title": "Phone number"
    },
    "preferred_payment_method": {
      "type": "string",
      "title": "Preferred payment method",
      "enum": [
        "bank_transfer",
        "card"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "admin_role": {
      "type": "string",
      "title": "Administrator role",
      "enum": [
        "super_admin",
        "administrator",
        "finance_manager",
        "project_manager"
      ],
      "enumColors": [
        "purple",
        "blue",
        "green",
        "yellow"
      ],
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "account_status": {
      "type": "string",
      "title": "Account status",
      "enum": [
        "active",
        "suspended"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "last_login_at": {
      "type": "string",
      "title": "Last administrator sign-in",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    }
  },
  "required": [
    "role"
  ]
}