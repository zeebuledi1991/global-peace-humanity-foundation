{
  "name": "GatewayCredential",
  "type": "object",
  "properties": {
    "gateway_id": {
      "type": "string",
      "title": "Gateway id"
    },
    "provider": {
      "type": "string",
      "title": "Provider key"
    },
    "environment": {
      "type": "string",
      "title": "Environment"
    },
    "cipher": {
      "type": "string",
      "title": "Encrypted credential payload"
    },
    "hints": {
      "type": "string",
      "title": "Masked field hints"
    },
    "saved_by": {
      "type": "string",
      "title": "Saved by"
    }
  },
  "required": [
    "gateway_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
