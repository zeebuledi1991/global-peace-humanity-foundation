{
  "name": "Program",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "slug": {
      "type": "string",
      "title": "URL slug"
    },
    "summary": {
      "type": "string",
      "title": "Short summary"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Objectives"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "image_alt": {
      "type": "string",
      "title": "Image description"
    },
    "icon": {
      "type": "string",
      "title": "Icon key"
    },
    "display_order": {
      "type": "number",
      "title": "Display order"
    },
    "is_published": {
      "type": "boolean",
      "title": "Published"
    }
  },
  "required": [
    "title",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}